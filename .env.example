# ─────────────────────────────────────────────────────────────
# Operación Botín — Variables de entorno (plantilla)
# Copia a .env y rellena con tus credenciales reales.
# NUNCA commitees .env — está en .gitignore.
# ─────────────────────────────────────────────────────────────

# API (Cloudflare Worker + Hono)
CF_ACCOUNT_ID=tu_account_id
CF_API_TOKEN=tu_api_token
CF_ENV=development

# Web (Astro)
PUBLIC_API_URL=http://localhost:8787

# Pipeline (Python)
# Claves de APIs de redes sociales (con rate-limit estricto)
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Almacenamiento
R2_BUCKET=operacion-botin-data
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# LLM / embeddings (para módulo RAG)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Base de datos vectorial (opcional, fase posterior)
QDRANT_URL=
QDRANT_API_KEY=
