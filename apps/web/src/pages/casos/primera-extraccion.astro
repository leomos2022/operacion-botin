---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Boton from '../../components/Boton.astro';
import Badge from '../../components/Badge.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import Stat from '../../components/Stat.astro';

const fechaAnalisis = '2026-10-07';
const totalPosts = 653;
const totalAutores = 468;
const plataformas = 3;

const terminosBluesky = [
  { termino: 'elecciones Colombia', posts: 29 },
  { termino: 'Abelardo de la Espriella', posts: 45 },
  { termino: 'desinformación Colombia', posts: 50 },
  { termino: 'bots políticos', posts: 47 },
];

const canalesTelegram = [
  { canal: '@masnoticia', posts: 16, descripcion: 'Noticias regionales Colombia' },
  { canal: '@DignidadColombia', posts: 24, descripcion: 'Política, antivacunas, propaganda' },
  { canal: '@colombiaaldiatel', posts: 23, descripcion: 'Política y clickbait' },
  { canal: '@AgendaPublica', posts: 21, descripcion: 'Análisis político España/LatAm' },
];

const videosYouTube = [
  { titulo: '¿Reelección? Mensaje de De la Espriella y respuesta de Petro', canal: 'Noticias Caracol', comentarios: 4 },
  { titulo: 'Elecciones 2026: propuestas de Cepeda y De la Espriella', canal: 'Noticias Caracol', comentarios: 98 },
  { titulo: 'Este es Abelardo de la Espriella, el nuevo presidente', canal: 'La Pulla', comentarios: 100 },
  { titulo: 'Decreto De la Espriella arma a la policía contra protestas', canal: 'Revista Raya', comentarios: 100 },
  { titulo: 'Emisión Noticias RCN 7pm (10 ago 2026)', canal: 'Noticias RCN', comentarios: 21 },
];

const topAutores = [
  { seudonimo: '@cuenta***63', posts: 26, alerta: true, confianza: 0.65, plataforma: 'Bluesky' },
  { seudonimo: '@cuenta***80', posts: 23, alerta: false, confianza: 0.0, plataforma: 'Telegram' },
  { seudonimo: '@cuenta***78', posts: 21, alerta: false, confianza: 0.0, plataforma: 'Telegram' },
  { seudonimo: '@cuenta***27', posts: 20, alerta: false, confianza: 0.0, plataforma: 'Bluesky' },
  { seudonimo: '@cuenta***19', posts: 16, alerta: false, confianza: 0.0, plataforma: 'Telegram' },
  { seudonimo: '@cuenta***50', posts: 10, alerta: false, confianza: 0.0, plataforma: 'Telegram' },
  { seudonimo: '@cuenta***01', posts: 4, alerta: false, confianza: 0.0, plataforma: 'YouTube' },
  { seudonimo: '@cuenta***49', posts: 4, alerta: false, confianza: 0.0, plataforma: 'YouTube' },
  { seudonimo: '@cuenta***06', posts: 4, alerta: false, confianza: 0.0, plataforma: 'Telegram' },
  { seudonimo: '@cuenta***72', posts: 3, alerta: false, confianza: 0.0, plataforma: 'YouTube' },
];

const hashtags = [
  { tag: '#Colombia', count: 7 },
  { tag: '#TerremotoColombia', count: 7 },
  { tag: '#desinformación', count: 6 },
  { tag: '#elecciones', count: 5 },
  { tag: '#subsidios', count: 3 },
  { tag: '#Monsterdon', count: 3 },
  { tag: '#SismoColombia', count: 3 },
  { tag: '#NosEnvian', count: 3 },
  { tag: '#gobierno', count: 3 },
];

const maxHashtagCount = Math.max(...hashtags.map((h) => h.count));
---

<BaseLayout
  rutaActiva="/casos"
  title="Primera extracción multicanal — Caso documentado · Operación Botín"
  description="Análisis multicanal: 653 posts de Bluesky, Telegram y YouTube, 468 autores. Una cuenta con señal de alerta, un texto repetido (frase común), cero coordinaciones."
>
  <section class="border-b border-white/5">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <Badge variant="verde" dot>Caso documentado</Badge>
        <Badge variant="rojo">Bot · confianza 0.65 (no publicado)</Badge>
        <Badge variant="muted">Análisis: {fechaAnalisis}</Badge>
        <Badge variant="verde">Multicanal: Bluesky + Telegram + YouTube</Badge>
      </div>
      <h1 class="font-[var(--font-display)] text-4xl md:text-5xl mb-4">
        Primera extracción multicanal: lo que encontramos (y lo que no).
      </h1>
      <p class="text-[var(--color-muted)] max-w-3xl text-lg leading-relaxed">
        Análisis sobre 653 posts de 3 plataformas (Bluesky + Telegram + YouTube) con 468
        autores/canales distintos. Mostramos los hallazgos con transparencia: incluida la
        ausencia de coordinación. Eso es lo que diferencia a un observatorio serio de un panel de opinión.
      </p>
    </div>
  </section>

  <section class="border-b border-white/5 bg-[var(--color-surface)]/30">
    <div class="mx-auto max-w-7xl px-6 py-12">
      <ScrollReveal>
        <h2 class="font-[var(--font-display)] text-2xl mb-6 border-l-4 border-[var(--color-rojo)] pl-4">El dataset</h2>
        <div class="grid gap-4 md:grid-cols-4">
          <Stat etiqueta="Posts únicos" valor={totalPosts.toString()} fuente="3 plataformas · 2026-10-07" variante="destacada" />
          <Stat etiqueta="Autores/canales" valor={totalAutores.toString()} fuente="Handles + canales + comentaristas" />
          <Stat etiqueta="Plataformas" valor={plataformas.toString()} fuente="Bluesky, Telegram, YouTube" />
          <Stat etiqueta="Período" valor="~5 meses" fuente="mayo - octubre 2026" />
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-7xl px-6 py-16">
      <ScrollReveal>
        <p class="font-[var(--font-mono)] text-xs uppercase tracking-[0.2em] text-[var(--color-rojo-claro)] mb-3">01 · Fuentes monitoreadas</p>
        <h2 class="font-[var(--font-display)] text-3xl mb-6">De dónde capturamos.</h2>
        <p class="text-[var(--color-muted)] leading-relaxed max-w-3xl mb-10">
          Tres plataformas, tres métodos. Bluesky: búsqueda por términos. Telegram: captura de canales públicos vía MTProto. YouTube: comentarios de videos políticos vía Data API v3.
        </p>
      </ScrollReveal>

      <ScrollReveal delay={120}>
        <div class="grid gap-6 lg:grid-cols-3">
          <div>
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-3">Bluesky — 4 términos</p>
            <div class="space-y-3">
              {terminosBluesky.map((t) => (
                <div class="rounded-lg border border-white/5 bg-[var(--color-surface)] p-4 flex items-center justify-between">
                  <span class="text-sm text-[var(--color-texto)]">"{t.termino}"</span>
                  <span class="font-[var(--font-display)] text-xl text-[var(--color-rojo)]">{t.posts}</span>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-3">Telegram — 4 canales</p>
            <div class="space-y-3">
              {canalesTelegram.map((c) => (
                <div class="rounded-lg border border-white/5 bg-[var(--color-surface)] p-4">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-[var(--font-mono)] text-sm text-[var(--color-texto)]">{c.canal}</span>
                    <span class="font-[var(--font-display)] text-xl text-[var(--color-rojo)]">{c.posts}</span>
                  </div>
                  <p class="text-xs text-[var(--color-muted)]">{c.descripcion}</p>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-3">YouTube — 5 videos</p>
            <div class="space-y-3">
              {videosYouTube.map((v) => (
                <div class="rounded-lg border border-white/5 bg-[var(--color-surface)] p-4">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-xs text-[var(--color-muted)] font-[var(--font-mono)]">{v.canal}</span>
                    <span class="font-[var(--font-display)] text-xl text-[var(--color-rojo)]">{v.comentarios}</span>
                  </div>
                  <p class="text-xs text-[var(--color-texto)] leading-snug">{v.titulo}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="border-t border-white/5 bg-[var(--color-surface)]/30">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <ScrollReveal>
        <p class="font-[var(--font-mono)] text-xs uppercase tracking-[0.2em] text-[var(--color-rojo-claro)] mb-3">02 · Hallazgos</p>
        <h2 class="font-[var(--font-display)] text-3xl mb-6">Qué encontramos.</h2>
      </ScrollReveal>

      <div class="grid gap-6 md:grid-cols-3">
        <ScrollReveal>
          <div class="h-full rounded-lg border border-[var(--color-ambar)]/30 bg-[var(--color-bg)] p-6">
            <Badge variant="ambar" dot>Señal leve</Badge>
            <h3 class="font-[var(--font-display)] text-xl mt-3 mb-2">1 cuenta atípica</h3>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">
              Una cuenta Bluesky con <strong class="text-[var(--color-texto)]">26 posts</strong> (4% del dataset) dispara
              señal de cobertura horaria amplia. Confianza <strong class="text-[var(--color-ambar-claro)]">0.65</strong> — por debajo
              del umbral de publicación (0.7). No se etiqueta como bot.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={120}>
          <div class="h-full rounded-lg border border-[var(--color-ambar)]/30 bg-[var(--color-bg)] p-6">
            <Badge variant="ambar" dot>1 texto repetido</Badge>
            <h3 class="font-[var(--font-display)] text-xl mt-3 mb-2">Frase común</h3>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">
              Detectamos 1 caso de texto idéntico entre 2 cuentas: <em>"que horror"</em>.
              <strong class="text-[var(--color-texto)]"> No constituye evidencia de coordinación:</strong>
              es una reacción natural común. La revisión humana descarta el falso positivo.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={240}>
          <div class="h-full rounded-lg border border-[var(--color-verde)]/30 bg-[var(--color-bg)] p-6">
            <Badge variant="verde" dot>Sin evidencia</Badge>
            <h3 class="font-[var(--font-display)] text-xl mt-3 mb-2">0 coordinaciones</h3>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">
              No se detectaron pares de cuentas publicando en ventanas de 60 segundos con similitud
              de texto &gt;30%. <strong class="text-[var(--color-texto)]">No hay evidencia de operación coordinada</strong>.
            </p>
          </div>
        </ScrollReveal>
      </div>

      <ScrollReveal delay={300}>
        <div class="mt-8 rounded-lg border-l-2 border-[var(--color-verde)] bg-[var(--color-bg)] p-6">
          <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-verde-claro)] mb-2">Lectura honesta</p>
          <p class="text-[var(--color-texto)] text-lg leading-relaxed">
            Con 653 posts en 3 plataformas y 468 autores, <strong>no detectamos operación coordinada</strong>.
            La única señal (texto repetido "que horror") es una frase común que cualquier persona diría
            ante noticias alarmantes — no es coordinación. El observatorio no inventa operaciones
            donde no las hay; reportar la ausencia de evidencia es también un hallazgo. Ampliar
            el dataset y la cobertura temporal permitirá detectar patrones sutiles.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <ScrollReveal>
        <p class="font-[var(--font-mono)] text-xs uppercase tracking-[0.2em] text-[var(--color-rojo-claro)] mb-3">03 · Autores con más posts</p>
        <h2 class="font-[var(--font-display)] text-3xl mb-6">Quién publica más.</h2>
        <p class="text-[var(--color-muted)] leading-relaxed max-w-3xl mb-8">
          Handles seudonimizados (regla §4.4). <strong class="text-[var(--color-texto)]">Publicar mucho
          no implica ser bot:</strong> un medio legítimo puede tener alto volumen. La señal de alerta
          es combinación de volumen + patrón temporal + repetición de contenido.
        </p>
      </ScrollReveal>

      <ScrollReveal delay={120}>
        <div class="overflow-x-auto rounded-lg border border-white/5">
          <table class="w-full text-sm">
            <thead class="bg-[var(--color-surface)]">
              <tr>
                <th class="px-4 py-3 text-left font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)]">Seudónimo</th>
                <th class="px-4 py-3 text-left font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)]">Plataforma</th>
                <th class="px-4 py-3 text-right font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)]">Posts</th>
                <th class="px-4 py-3 text-right font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)]">Confianza</th>
                <th class="px-4 py-3 text-left font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)]">Estado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {topAutores.map((a) => (
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="px-4 py-3 font-[var(--font-mono)] text-[var(--color-texto)]">{a.seudonimo}</td>
                  <td class="px-4 py-3 text-[var(--color-muted)] font-[var(--font-mono)] text-xs">{a.plataforma}</td>
                  <td class="px-4 py-3 text-right font-[var(--font-mono)] text-[var(--color-texto)]">{a.posts}</td>
                  <td class="px-4 py-3 text-right font-[var(--font-mono)]">
                    {a.confianza > 0 ? (
                      <span class={a.alerta ? 'text-[var(--color-ambar-claro)]' : 'text-[var(--color-muted)]'}>
                        {a.confianza.toFixed(2)}
                      </span>
                    ) : (
                      <span class="text-[var(--color-muted)]/40">—</span>
                    )}
                  </td>
                  <td class="px-4 py-3">
                    {a.alerta ? (
                      <Badge variant="ambar" dot>Seguimiento</Badge>
                    ) : (
                      <Badge variant="muted">Sin señal</Badge>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="border-t border-white/5 bg-[var(--color-surface)]/30">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <ScrollReveal>
        <p class="font-[var(--font-mono)] text-xs uppercase tracking-[0.2em] text-[var(--color-rojo-claro)] mb-3">04 · Hashtags</p>
        <h2 class="font-[var(--font-display)] text-3xl mb-6">Temas recurrentes.</h2>
        <p class="text-[var(--color-muted)] leading-relaxed max-w-3xl mb-10">
          Hashtags más frecuentes (principalmente de Bluesky y Telegram; YouTube tiene menos hashtags en comentarios).
          <strong class="text-[var(--color-texto)]">Un hashtag frecuente no es evidencia de coordinación</strong>:
          puede ser tendencia orgánica.
        </p>
      </ScrollReveal>

      <ScrollReveal delay={120}>
        <div class="space-y-3">
          {hashtags.map((h) => (
            <div class="flex items-center gap-4">
              <div class="w-48 font-[var(--font-mono)] text-sm text-[var(--color-texto)]">{h.tag}</div>
              <div class="flex-1 h-6 bg-[var(--color-bg)] rounded-md overflow-hidden">
                <div class="h-full bg-gradient-to-r from-[var(--color-rojo)]/40 to-[var(--color-rojo)] transition-all" style={`width: ${(h.count / maxHashtagCount) * 100}%`}></div>
              </div>
              <div class="w-12 text-right font-[var(--font-mono)] text-sm text-[var(--color-muted)]">{h.count}</div>
            </div>
          ))}
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="border-t border-white/5">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <ScrollReveal>
        <p class="font-[var(--font-mono)] text-xs uppercase tracking-[0.2em] text-[var(--color-rojo-claro)] mb-3">05 · Limitaciones</p>
        <h2 class="font-[var(--font-display)] text-3xl mb-6">Qué no podemos afirmar.</h2>
        <ul class="space-y-5">
          <li class="flex gap-4">
            <span class="font-[var(--font-mono)] text-[var(--color-rojo-claro)] flex-shrink-0">01</span>
            <div>
              <p class="text-[var(--color-texto)] font-semibold mb-1">Dataset acotado.</p>
              <p class="text-sm text-[var(--color-muted)] leading-relaxed">653 posts en 3 plataformas es mejor que antes, pero aún insuficiente para detectar patrones sutiles de coordinación. Necesitamos miles de posts y capturas longitudinales (semanales) para encontrar sincronías reales.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="font-[var(--font-mono)] text-[var(--color-rojo-claro)] flex-shrink-0">02</span>
            <div>
              <p class="text-[var(--color-texto)] font-semibold mb-1">No cubrimos las plataformas más usadas en Colombia.</p>
              <p class="text-sm text-[var(--color-muted)] leading-relaxed">WhatsApp (cifrado E2E, no accesible), Facebook, Instagram y TikTok requieren trámites de acceso para investigadores (Meta Content Library, TikTok Research API). Estamos en proceso de solicitar acceso. Mientras tanto, lo que no vemos en estas plataformas puede existir y no lo detectamos.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="font-[var(--font-mono)] text-[var(--color-rojo-claro)] flex-shrink-0">03</span>
            <div>
              <p class="text-[var(--color-texto)] font-semibold mb-1">Sin atribución de intenciones.</p>
              <p class="text-sm text-[var(--color-muted)] leading-relaxed">Describimos comportamiento, no intenciones. Decir "esta cuenta publica mucho a las 3am" no es lo mismo que decir "para influir en la elección X". La atribución requiere investigación periodística firmada.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="font-[var(--font-mono)] text-[var(--color-rojo-claro)] flex-shrink-0">04</span>
            <div>
              <p class="text-[var(--color-texto)] font-semibold mb-1">Sin identificación de operador humano.</p>
              <p class="text-sm text-[var(--color-muted)] leading-relaxed">Aunque detectáramos un bot con confianza alta, no podemos atribuirlo a una persona o institución específica sin evidencia adicional externa.</p>
            </div>
          </li>
        </ul>
      </ScrollReveal>
    </div>
  </section>

  <section class="border-t border-white/5 bg-[var(--color-surface)]/30">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <ScrollReveal>
        <p class="font-[var(--font-mono)] text-xs uppercase tracking-[0.2em] text-[var(--color-rojo-claro)] mb-3">06 · Próximos pasos</p>
        <h2 class="font-[var(--font-display)] text-3xl mb-6">Cómo continúa esto.</h2>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-white/5 bg-[var(--color-bg)] p-5">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-2">Ampliar YouTube</p>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">Capturar comentarios de 20+ videos políticos más para triplicar el volumen de YouTube.</p>
          </div>
          <div class="rounded-lg border border-white/5 bg-[var(--color-bg)] p-5">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-2">Meta Content Library</p>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">Solicitado acceso a Facebook e Instagram públicos. Revisión típica: 2-4 semanas.</p>
          </div>
          <div class="rounded-lg border border-white/5 bg-[var(--color-bg)] p-5">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-2">Captura longitudinal</p>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">Capturas semanales recurrentes para detectar patrones a lo largo del tiempo.</p>
          </div>
          <div class="rounded-lg border border-white/5 bg-[var(--color-bg)] p-5">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-2">Heurística ciclo sueño/vigilia</p>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">Mejorar detector para identificar bots que simulan ciclos humanos (evasión de detección).</p>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="border-t border-white/5">
    <div class="mx-auto max-w-3xl px-6 py-12">
      <ScrollReveal>
        <div class="rounded-lg border-l-2 border-[var(--color-rojo)] bg-[var(--color-surface)] p-6">
          <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-2">Fuente y método</p>
          <p class="text-[var(--color-muted)] leading-relaxed mb-3">
            Datos capturados vía APIs públicas (AT Protocol de Bluesky + MTProto de Telegram +
            YouTube Data API v3) el {fechaAnalisis}, usando el pipeline
            <code class="font-[var(--font-mono)] text-[var(--color-texto)]">operacion-botin/pipeline</code>.
            Los 653 posts únicos están disponibles en formato Parquet en
            <code class="font-[var(--font-mono)] text-[var(--color-texto)]">packages/shared/data/raw/</code>
            con ficha de metadatos por extracción.
          </p>
          <p class="text-[var(--color-muted)] leading-relaxed">
            Análisis ejecutado con 3 familias de heurísticas (temporal, contenido, grafo) según
            la metodología pública del observatorio. Identificadores seudonimizados.
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <Boton variant="secundario" size="sm" href="/metodologia">Ver metodología</Boton>
            <Boton variant="fantasma" size="sm" href="/casos">Volver a casos</Boton>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
