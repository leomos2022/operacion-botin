---
import BaseLayout from '../layouts/BaseLayout.astro';
import Boton from '../components/Boton.astro';
import Badge from '../components/Badge.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
---

<BaseLayout
  rutaActiva="/verifica"
  title="Verifica — Operación Botín"
  description="¿Viste una cuenta o mensaje sospechoso? Repórtalo. Te explicamos qué información necesitamos y cómo la tratamos."
>
  <section class="border-b border-white/5">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="font-[var(--font-mono)] text-xs uppercase tracking-[0.2em] text-[var(--color-rojo-claro)] mb-4">Fase 0.6 · formulario funcional</p>
      <h1 class="font-[var(--font-display)] text-4xl md:text-5xl mb-4">Verifica</h1>
      <p class="text-[var(--color-muted)] max-w-2xl text-lg leading-relaxed">
        La observación ciudadana fortalece el observatorio. Si ves una cuenta o mensaje que parezca parte de una operación coordinada, repórtalo. Te decimos qué necesitamos y cómo protegemos tu identidad.
      </p>
    </div>
  </section>

  <section class="border-b border-white/5 bg-[var(--color-surface)]/30">
    <div class="mx-auto max-w-7xl px-6 py-12">
      <ScrollReveal>
        <h2 class="font-[var(--font-display)] text-2xl mb-6 border-l-4 border-[var(--color-rojo)] pl-4">Cómo funciona el reporte</h2>
      </ScrollReveal>
      <div class="grid gap-4 md:grid-cols-3">
        <ScrollReveal>
          <div class="h-full rounded-lg border border-white/5 bg-[var(--color-bg)] p-5">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-3">01 · Recibe</p>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">Nos envías la URL o captura de la cuenta o mensaje. Sin datos personales tuyos.</p>
          </div>
        </ScrollReveal>
        <ScrollReveal delay={120}>
          <div class="h-full rounded-lg border border-white/5 bg-[var(--color-bg)] p-5">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-3">02 · Verifica</p>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">Aplicamos el pipeline de etiquetado y revisión humana. Te respondemos con el resultado del análisis.</p>
          </div>
        </ScrollReveal>
        <ScrollReveal delay={240}>
          <div class="h-full rounded-lg border border-white/5 bg-[var(--color-bg)] p-5">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-rojo-claro)] mb-3">03 · Documenta</p>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">Si confirma un patrón, lo agregamos a la base de datos y aparece (sin datos tuyos) en el índice de casos.</p>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-6 py-16 md:py-24">
      <ScrollReveal>
        <div class="flex items-center gap-3 mb-3">
          <h2 class="font-[var(--font-display)] text-3xl">Formulario de reporte</h2>
          <Badge variant="ambar" dot>Frontend · sin backend aún</Badge>
        </div>
        <p class="text-[var(--color-muted)] leading-relaxed mb-8">
          Este formulario valida los datos en el navegador. Aún no envía a un servidor (el backend se implementa en la Fase 1 junto al pipeline). Mientras tanto, puedes escribirnos a
          <a href="mailto:reportes@operacionbotin.co" class="text-[var(--color-rojo-claro)] hover:underline font-[var(--font-mono)]">reportes@operacionbotin.co</a>.
        </p>
      </ScrollReveal>

      <ScrollReveal delay={120}>
        <form id="form-reporte" class="rounded-lg border border-white/5 bg-[var(--color-surface)] p-6 md:p-8 space-y-6" novalidate>
          <div>
            <label for="plataforma" class="block font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)] mb-2">Plataforma <span class="text-[var(--color-rojo-claro)]">*</span></label>
            <select id="plataforma" name="plataforma" required class="w-full rounded-md border border-white/10 bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-texto)] focus:border-[var(--color-rojo)] focus:outline-none focus:ring-1 focus:ring-[var(--color-rojo)] transition-colors">
              <option value="">Selecciona una plataforma…</option>
              <option value="twitter">Twitter / X</option>
              <option value="telegram">Telegram</option>
              <option value="bluesky">Bluesky</option>
              <option value="facebook">Facebook</option>
              <option value="tiktok">TikTok</option>
              <option value="instagram">Instagram</option>
              <option value="otra">Otra</option>
            </select>
            <p class="error mt-1.5 text-xs text-[var(--color-rojo-claro)] font-[var(--font-mono)] hidden" data-error-for="plataforma">Selecciona una plataforma.</p>
          </div>

          <div>
            <label for="url" class="block font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)] mb-2">URL o identificador de la cuenta/mensaje <span class="text-[var(--color-rojo-claro)]">*</span></label>
            <input type="text" id="url" name="url" required placeholder="https://twitter.com/cuenta/status/123… o @cuenta***" class="w-full rounded-md border border-white/10 bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-texto)] placeholder-[var(--color-muted)]/50 focus:border-[var(--color-rojo)] focus:outline-none focus:ring-1 focus:ring-[var(--color-rojo)] transition-colors" />
            <p class="error mt-1.5 text-xs text-[var(--color-rojo-claro)] font-[var(--font-mono)] hidden" data-error-for="url">Indica la URL o identificador.</p>
          </div>

          <div>
            <label for="fecha" class="block font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)] mb-2">Fecha en la que lo viste <span class="text-[var(--color-rojo-claro)]">*</span></label>
            <input type="date" id="fecha" name="fecha" required class="w-full rounded-md border border-white/10 bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-texto)] focus:border-[var(--color-rojo)] focus:outline-none focus:ring-1 focus:ring-[var(--color-rojo)] transition-colors" />
            <p class="error mt-1.5 text-xs text-[var(--color-rojo-claro)] font-[var(--font-mono)] hidden" data-error-for="fecha">Indica la fecha.</p>
          </div>

          <div>
            <label for="contexto" class="block font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)] mb-2">Contexto — ¿por qué te parece sospechoso? <span class="text-[var(--color-rojo-claro)]">*</span></label>
            <textarea id="contexto" name="contexto" required rows="5" placeholder="Describe el patrón: horario, repetición, sincronía con otras cuentas, hashtags inusuales, etc. Cuanto más específico, más útil." class="w-full rounded-md border border-white/10 bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-texto)] placeholder-[var(--color-muted)]/50 focus:border-[var(--color-rojo)] focus:outline-none focus:ring-1 focus:ring-[var(--color-rojo)] transition-colors resize-y"></textarea>
            <p class="error mt-1.5 text-xs text-[var(--color-rojo-claro)] font-[var(--font-mono)] hidden" data-error-for="contexto">Añade contexto para que podamos evaluar el reporte.</p>
            <p class="mt-1.5 text-xs text-[var(--color-muted)] font-[var(--font-mono)]"><span id="contador">0</span> / 1000 caracteres</p>
          </div>

          <div>
            <label for="captura" class="block font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-muted)] mb-2">Captura de pantalla <span class="text-[var(--color-muted)]">(opcional)</span></label>
            <input type="file" id="captura" name="captura" accept="image/*" class="w-full text-sm text-[var(--color-muted)] file:mr-4 file:rounded-md file:border-0 file:bg-[var(--color-rojo)] file:px-4 file:py-2 file:text-[var(--color-bg)] file:font-[var(--font-body)] file:font-semibold hover:file:opacity-90 cursor-pointer" />
            <p class="mt-1.5 text-xs text-[var(--color-muted)] font-[var(--font-mono)]">PNG, JPG o WEBP. Máximo 5 MB. Borra metadata EXIF automáticamente.</p>
          </div>

          <div class="rounded-lg border-l-2 border-[var(--color-verde)] bg-[var(--color-bg)] p-4">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-verde-claro)] mb-2">Privacidad</p>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">
              No guardamos tu identidad. No pedimos email ni nombre. El reporte es anónimo por defecto. Tampoco publicamos identificadores de cuentas sin seudonimizar (regla editorial §4.4).
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <Boton variant="primario" type="submit">Enviar reporte</Boton>
            <Boton variant="fantasma" type="reset">Limpiar</Boton>
          </div>

          <div id="form-exito" class="hidden rounded-lg border border-[var(--color-verde)]/30 bg-[var(--color-verde)]/10 p-4">
            <p class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[var(--color-verde-claro)] mb-1">Reporte recibido (simulado)</p>
            <p class="text-sm text-[var(--color-texto)]">
              Tu reporte pasó la validación. Cuando el backend esté activo en la Fase 1, se enviará al pipeline. Por ahora, reenvía los datos a
              <a href="mailto:reportes@operacionbotin.co" class="text-[var(--color-verde-claro)] hover:underline">reportes@operacionbotin.co</a>.
            </p>
          </div>
        </form>
      </ScrollReveal>
    </div>
  </section>

  <section class="border-t border-white/5 bg-[var(--color-surface)]/30">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center">
      <ScrollReveal>
        <h2 class="font-[var(--font-display)] text-2xl md:text-3xl mb-4">¿Quieres entender cómo evaluamos tu reporte?</h2>
        <p class="text-[var(--color-muted)] mb-8 max-w-xl mx-auto">La metodología explica qué señales buscamos y qué confianza exigimos antes de publicar una etiqueta.</p>
        <Boton variant="secundario" href="/metodologia">Ver metodología</Boton>
      </ScrollReveal>
    </div>
  </section>

  <script is:inline>
    (function () {
      const form = document.getElementById('form-reporte');
      if (!form) return;
      const textarea = form.querySelector('#contexto');
      const contador = document.getElementById('contador');
      const exito = document.getElementById('form-exito');

      textarea.addEventListener('input', () => {
        const len = textarea.value.length;
        contador.textContent = len;
        contador.style.color = len > 1000 ? 'var(--color-rojo-claro)' : '';
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        let valido = true;
        form.querySelectorAll('[data-error-for]').forEach((el) => el.classList.add('hidden'));
        const campos = ['plataforma', 'url', 'fecha', 'contexto'];
        campos.forEach((name) => {
          const campo = form.elements[name];
          if (!campo.value.trim()) {
            const err = form.querySelector('[data-error-for="' + name + '"]');
            if (err) err.classList.remove('hidden');
            campo.focus();
            valido = false;
          }
        });
        if (textarea.value.length > 1000) {
          const err = form.querySelector('[data-error-for="contexto"]');
          if (err) { err.textContent = 'Máximo 1000 caracteres.'; err.classList.remove('hidden'); }
          valido = false;
        }
        if (valido) {
          exito.classList.remove('hidden');
          exito.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });

      form.addEventListener('reset', () => {
        exito.classList.add('hidden');
        form.querySelectorAll('[data-error-for]').forEach((el) => el.classList.add('hidden'));
        contador.textContent = '0';
        contador.style.color = '';
      });
    })();
  </script>
</BaseLayout>
