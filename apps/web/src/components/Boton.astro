---
type Variant = 'primario' | 'secundario' | 'fantasma' | 'peligro';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  ['aria-label']?: string;
}

const {
  variant = 'primario',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 font-[var(--font-body)] font-semibold rounded-md transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-rojo)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)] disabled:opacity-50 disabled:cursor-not-allowed';

const variants: Record<Variant, string> = {
  primario: 'bg-[var(--color-rojo)] text-[var(--color-bg)] hover:opacity-90 active:scale-[0.98]',
  secundario: 'border border-white/15 text-[var(--color-texto)] hover:border-white/30 hover:bg-white/5',
  fantasma: 'text-[var(--color-muted)] hover:text-[var(--color-texto)] hover:bg-white/5',
  peligro: 'bg-transparent border border-[var(--color-rojo)] text-[var(--color-rojo)] hover:bg-[var(--color-rojo)]/10',
};

const sizes: Record<Size, string> = {
  sm: 'text-xs px-3 py-1.5',
  md: 'text-sm px-5 py-2.5',
  lg: 'text-base px-7 py-3.5',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
const Tag = href ? 'a' : 'button';
const extraProps = href ? { href } : { type, disabled };
---

<Tag class={classes} {...extraProps} {...rest}>
  <slot />
</Tag>
