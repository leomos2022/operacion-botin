---
type Variant = 'rojo' | 'verde' | 'ambar' | 'muted';

interface Props {
  variant?: Variant;
  dot?: boolean;
  class?: string;
}

const { variant = 'muted', dot = false, class: className = '' } = Astro.props;

const variants: Record<Variant, string> = {
  rojo: 'bg-[var(--color-rojo)]/10 text-[var(--color-rojo)] border border-[var(--color-rojo)]/20',
  verde: 'bg-[var(--color-verde)]/10 text-[var(--color-verde)] border border-[var(--color-verde)]/20',
  ambar: 'bg-[var(--color-ambar)]/10 text-[var(--color-ambar)] border border-[var(--color-ambar)]/20',
  muted: 'bg-white/5 text-[var(--color-muted)] border border-white/10',
};

const dotColors: Record<Variant, string> = {
  rojo: 'bg-[var(--color-rojo)]',
  verde: 'bg-[var(--color-verde)]',
  ambar: 'bg-[var(--color-ambar)]',
  muted: 'bg-[var(--color-muted)]',
};

const classes = `inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-[var(--font-mono)] uppercase tracking-wider ${variants[variant]} ${className}`;
---

<span class={classes}>
  {dot && <span class={`inline-block h-1.5 w-1.5 rounded-full ${dotColors[variant]}`} aria-hidden="true" />}
  <slot />
</span>
